# ==============================================================================
# 曾练彩票助手 (Bazi Lottery AI) 环境变量配置示例
# 复制为 .env 并填入真实密钥（切勿将 .env 提交至 Git 仓库）
# ==============================================================================

# 运行环境: development | production
ENV=development
PORT=8080
TZ=Asia/Shanghai

# 本地 SQLite 数据库路径
LOTTERY_DB_PATH=/app/data/lottery.db

# 鉴权与防重放密钥（生产环境务必设置为 32 位以上随机字符串）
ADMIN_TOKEN=replace-with-strong-admin-token
AI_SERVICE_TOKEN=replace-with-optional-ai-service-token
APP_HMAC_SECRET=replace-with-strong-hmac-secret

# 大模型中继密钥（至少配置其中一个即可启用云端真 AI 解盘；未配置时自动降级本地典籍）
AI_DEFAULT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 启动自动拉取官网开奖（建议在 Cloud Run 关闭，改由 Cloud Scheduler 定时触发 /api/lottery/sync）
AUTO_SYNC_ON_STARTUP=false

# 零成本 GCS 状态持久化（可选：仅在 Cloud Run 单实例部署时填写）
GCS_STATE_BUCKET=
GCS_STATE_OBJECT=bazi-lottery/lottery.db

# 反向代理 IP 解析配置
TRUST_X_FORWARDED_FOR=true
TRUSTED_PROXY_COUNT=1
